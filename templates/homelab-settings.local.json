{
  "permissions": {
    "allow": [
      "Bash(./scripts/validate-repo.sh *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh release *)"
    ]
  }
}
